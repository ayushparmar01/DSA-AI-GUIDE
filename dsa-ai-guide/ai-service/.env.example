# ==================================================
# DSA AI GUIDE - AI SERVICE ENVIRONMENT VARIABLES
# ==================================================

# Service Network Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Deterministic Leakage Guard Settings
LEAKAGE_THRESHOLD=0.80

# External LLM Provider Adapter (Multi-Provider: claude | openai | mock)
# As documented in Progress Report 03, Claude API is primary, OpenAI is fallback
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=your_anthropic_api_key_placeholder
OPENAI_API_KEY=your_openai_api_key_placeholder

# Path to persisted ML model artifacts (joblib)
ML_MODELS_DIR=app/ml/models
