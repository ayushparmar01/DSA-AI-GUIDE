# ==================================================
# DSA AI GUIDE - ROOT MONOREPO CONFIGURATION
# ==================================================

# Environment Mode
NODE_ENV=development

# Web Backend (Node.js + Express)
BACKEND_PORT=5001
MONGO_URI=mongodb://localhost:27017/dsa_ai_guide
JWT_SECRET=your_jwt_secret_placeholder_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_placeholder

# Web Frontend (React 18 + Vite)
CLIENT_URL=http://localhost:5173
VITE_API_URL=http://localhost:5001/api
VITE_AI_SERVICE_URL=http://localhost:8000/api/v1

# AI Microservice (Python 3 + FastAPI)
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://localhost:8000
LEAKAGE_THRESHOLD=0.80

# External Integrations (Optional / Placeholders)
ANTHROPIC_API_KEY=your_anthropic_api_key_placeholder
OPENAI_API_KEY=your_openai_api_key_placeholder
JUDGE0_API_URL=http://localhost:2358
JUDGE0_API_KEY=your_judge0_api_key_placeholder
