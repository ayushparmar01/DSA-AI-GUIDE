# ==================================================
# DSA AI GUIDE - BACKEND ENVIRONMENT VARIABLES
# ==================================================

# Server Environment
NODE_ENV=development
PORT=5001
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB)
MONGO_URI=mongodb://localhost:27017/dsa_ai_guide

# JWT Authentication
JWT_SECRET=your_jwt_secret_placeholder_min_32_chars
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_placeholder
JWT_REFRESH_EXPIRE=30d

# Microservices Integration
AI_SERVICE_URL=http://localhost:8000

# Code Execution Sandbox (Judge0)
JUDGE0_API_URL=http://localhost:2358
JUDGE0_API_KEY=your_judge0_api_key_placeholder
CODE_EXEC_TIMEOUT_MS=3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
